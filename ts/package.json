{
	"name": "@mediaryorg/mediary-contracts",
	"version": "0.1.0",
	"description": "TypeScript types for the Mediary cloud API. Generated from the OpenAPI document; do not edit by hand.",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": ["dist"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
